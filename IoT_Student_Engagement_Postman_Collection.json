    {
      "name": "2. Authentication",
      "item": [
        {
          "name": "Register Student",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.environment.set('AUTH_TOKEN', jsonData.token);",
                  "    pm.environment.set('STUDENT_ID', jsonData.user._id);",
                  "    console.log('Token and Student ID saved!');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Atharva\",\n  \"lastName\": \"Student\",\n  \"email\": \"atharva.student@test.com\",\n  \"password\": \"Test@1234\",\n  \"userType\": \"student\",\n  \"phone\": \"+919876543210\",\n  \"grade\": \"10\",\n  \"school\": \"Test High School\",\n  \"dateOfBirth\": \"2008-05-15\"\n}"
