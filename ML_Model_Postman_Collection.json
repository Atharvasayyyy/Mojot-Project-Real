            },
            "url": {
              "raw": "{{ML_URL}}/predict",
              "host": ["{{ML_URL}}"],
              "path": ["predict"]
            },
            "description": "Stressed student sensor data\n\nCharacteristics:\n- Elevated heart rate (105 bpm)\n- Low HRV (18.3 ms)\n- High motion and restlessness\n- Low blood oxygen\n\nExpected: Medium engagement, High stress"
          },
          "response": []
        },
