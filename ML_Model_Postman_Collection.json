{
  "info": {
    "name": "IoT ML Model Testing - Complete API Collection",
    "description": "API collection for testing ML Model predictions for student engagement, stress detection, and hobby detection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "ML_URL",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "BACKEND_URL",
      "value": "http://localhost:5000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "🤖 ML Model Health & Info",
      "item": [
        {
          "name": "1. ML Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{ML_URL}}/health",
              "host": ["{{ML_URL}}"],
              "path": ["health"]
            },
            "description": "Check if ML model API is running and healthy"
          },
          "response": []
        },
        {
          "name": "2. API Docs (Swagger)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{ML_URL}}/docs",
              "host": ["{{ML_URL}}"],
              "path": ["docs"]
            },
            "description": "Access OpenAPI/Swagger documentation"
          },
          "response": []
        }
      ]
    },
    {
      "name": "🧠 ML Predictions - Test Cases",
      "item": [
        {
          "name": "TEST 1: Normal Engaged Student",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"heart_rate\": 72,\n  \"hrv_rmssd\": 45.5,\n  \"blood_oxygen\": 97,\n  \"motion_level\": 5.2,\n  \"restlessness_index\": 0.08\n}"
            },
            "url": {
              "raw": "{{ML_URL}}/predict",
              "host": ["{{ML_URL}}"],
              "path": ["predict"]
            },
            "description": "Normal, engaged student sensor data\n\nExpected: High engagement, Normal stress, Relaxed"
          },
          "response": []
        },
        {
          "name": "TEST 2: Stressed Student",
